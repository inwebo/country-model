{
    "name": "inwebo/country-model",
    "description": "Iso 3166 code's PHP implementation",
    "type": "library",
    "require": {
        "php": "^7.4|^8.0"
    },
  "keywords": [
    "geolocation",
    "country",
    "iso 3166",
    "iso 3166-1"
  ],
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1"
    },
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Inwebo\\Geolocation\\Country\\": "src/"
        }
    },
    "authors": [
        {
            "name": "inwebo",
            "email": "github@inwebo.net"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
      "php-cs-fixer": "vendor/bin/php-cs-fixer --allow-risky=yes fix",
      "phpstan": "vendor/bin/phpstan analyse src -c phpstan.neon"
    }
}
